<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Sites-presente | Ela Sorriu</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet"><link rel="stylesheet" href="/style.css?v=63"><script src="/admin.js" defer></script></head>
<body class="admin-page"><%- include('partials/admin-header', { admin, csrfToken, activeSection }) %><main class="admin-shell"><div class="admin-heading"><div><p class="kicker">Pagamento</p><h1>Sites-presente</h1></div><span><%= sites.length %> <%= sites.length === 1 ? 'site' : 'sites' %></span></div><% if (released) { %><p class="admin-alert is-success">Site liberado com sucesso.</p><% } %><% if (!sites.length) { %><section class="admin-empty"><h2>Nenhum site-presente por aqui.</h2><p>Os sites criados pelos clientes aparecerão nesta tela.</p></section><% } else { %><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Site</th><th>Cliente</th><th>Pagamento</th><th>Criado em</th><th>Ação</th></tr></thead><tbody><% sites.forEach(function(site) { %><tr><td data-label="Site"><strong><%= site.pageTitle || site.recipientName %></strong><small>/presente/<%= site.slug %></small></td><td data-label="Cliente"><%= site.senderName %></td><td data-label="Pagamento"><span class="status-pill <%= site.paymentStatus === 'paid' ? 'status--confirmado' : 'status--em-contato' %>"><%= site.paymentStatus === 'paid' ? 'Pago e liberado' : 'Aguardando pagamento' %></span><small><%= site.paymentMethod === 'pix' ? 'Pix' : site.paymentMethod === 'card' ? 'Cartão' : 'A combinar' %></small></td><td data-label="Criado em"><%= new Date(site.createdAt * 1000).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short', timeZone: 'America/Sao_Paulo' }) %></td><td data-label="Ação" class="admin-row-actions"><a class="admin-row-link" href="/presente/<%= site.slug %>" target="_blank" rel="noopener">Ver página ↗</a><% if (site.paymentStatus !== 'paid') { %><form action="/admin/gift-sites/<%= site.id %>/release" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-row-link" type="submit">Confirmar pagamento e liberar</button></form><% } %></td></tr><% }) %></tbody></table></div><% } %></main></body></html>
