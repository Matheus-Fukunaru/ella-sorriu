PORT=
NODE_ENV=
# Railway: crie um Volume montado em /data e use este caminho.
DATABASE_URL=file:/data/ella-sorriu.db
SESSION_SECRET=
INSTALL_TOKEN=
APP_URL=

# Em Render/Railway ou atrás de um único proxy HTTPS, mantenha 1.
# Em servidor exposto diretamente à internet, use 0.
TRUST_PROXY_HOPS=

# Preencha apenas se o frontend estiver em outro domínio HTTPS.
CORS_ORIGIN=

# Opcionais: aviso de pedido por e-mail
ADMIN_EMAIL=elasorriu.presentes@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=elasorriu.presentes@gmail.com
SMTP_PASS=
SMTP_FROM=Ela Sorriu <elasorriu.presentes@gmail.com>

# Aviso automático de novo pedido pelo WhatsApp Business Cloud API.
# O telefone que envia é 5511940346224 e quem recebe o aviso é 5511994958977.
# Deixe TOKEN e PHONE_NUMBER_ID vazios até conectar a conta oficial no Meta.
WHATSAPP_SENDER_NUMBER=5511940346224
WHATSAPP_ADMIN_NUMBER=5511994958977
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# Ajuste conforme a versão liberada pela Meta para a sua conta.
WHATSAPP_GRAPH_API_VERSION=v23.0

# Mini-sites presenteáveis: o fluxo entregue está em modo de teste.
# Não há cobrança real enquanto um provedor e credenciais sandbox não forem configurados.
PAYMENT_MODE=test
